#!/usr/bin/env bash
name='cmake'
release='10'
version='4.3.4'
url='https://github.com/Kitware/CMake'
description='A cross-platform open-source make system'
email='aliriza.keskin@pardus.org.tr'
maintainer='aliriza'
license=('GPLv3')
source=("https://github.com/Kitware/CMake/releases/download/v$version/cmake-$version.tar.gz")
depends=()
makedepends=()
sha256sums=('fdeff897b9eb49d764539f2b1edc6eb7e1440df325678a97c1978499e931adda')
uses=()
uses_extra=(qt)
group=(dev.util)
arch=('x86_64')

cd $name-$version

setup(){
    ./bootstrap --prefix=/usr \
        --no-system-libs \
        $(use_opt qt --qt-gui --no-qt-gui) \
        --parallel=`nproc`
}

build(){
    make $jobs
}

package(){
    make install $jobs
}

