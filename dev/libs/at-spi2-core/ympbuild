#!/usr/bin/env bash
name='at-spi2-core'
release='5'
version='2.62.1'
url='https://gitlab.gnome.org/GNOME/at-spi2-core'
description='GTK+ & GNOME Accessibility Toolkit'
email='akarsu@protonmail.com'
maintainer='akarsu'
license=('GPLv3')
source=("https://download.gnome.org/sources/at-spi2-core/2.62/at-spi2-core-$version.tar.xz")
depends=(glib libffi libpcre2 libXtst)
makedepends=()
sha256sums=('cca6b6a86e4389d89b370288761ce2385ddeceb10c4412da78689bc30c88af2d')
group=(dev.libs)
uses=()
arch=('x86_64')

cd $name-$version

setup(){
    meson setup build --prefix=/usr \
        --libdir=/usr/lib64/ 

}

build(){
    ninja -C build
}

package(){
    ninja -C build install
}

