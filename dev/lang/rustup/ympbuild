#!/usr/bin/env bash
name='rustup'
release='2'
version='1.29.2'
url='https://www.rust-lang.org/'
description='Rust compiler downlaoder'
email='parduscix@yandex.ru'
maintainer='sulincix'
license=('GPLv3')
source=('https://sh.rustup.rs'
        'rust.profile')
depends=()
makedepends=()
sha256sums=('9502b514362a21096210d498f143b8cdacda365d3dfcf45e8f5541e089ccafc0'
            'SKIP')
group=(dev.lang)
uses=()
arch=('x86_64')

package () {
    mkdir -p $DESTDIR/etc/profile.d/
    mkdir -p $DESTDIR/usr/bin
    install sh.rustup.rs $DESTDIR/usr/bin/rustup-init
    ln -s rustup-init $DESTDIR/usr/bin/rustup
    install rust.profile $DESTDIR/etc/profile.d/rust.sh
}

