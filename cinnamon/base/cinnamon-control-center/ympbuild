#!/usr/bin/env bash
name='cinnamon-control-center'
release='5'
version='6.8.1'
url='https://github.com/linuxmint/cinnamon-control-center'
description='The Control Center for Cinnamon'
email='brkt8khn@gmail.com'
maintainer='brkt8khn'
license=('GPLv3')
source=("https://github.com/linuxmint/cinnamon-control-center/archive/refs/tags/6.8.1.tar.gz")
depends=(cinnamon-settings-daemon cinnamon-menus colord libgnomekbd networkmanager libnma)
makedepends=(meson)
sha256sums=('c58c03a4de6102946ba97a54140f9cf20b909f9e3ca70d515d0d41de931bb705')
group=(cinnamon.base)
uses=()
arch=('x86_64')

cd $name-$version

setup () {
    meson setup build --prefix=/usr \
     		--libdir=/usr/lib64/ \
    		-Dmodemmanager=false \
    		-Donlineaccounts=false
}

build () {
    ninja -C build $jobs
}

package () {
     ninja -C build install $jobs
}

