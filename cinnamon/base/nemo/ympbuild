#!/usr/bin/env bash
name='nemo'
release='7'
version='6.8.5'
url='https://github.com/linuxmint/nemo'
description='File manager for the Cinnamon desktop environment'
email='brkt8khn@gmail.com'
maintainer='brkt8khn'
license=('GPLv2')
source=("https://github.com/linuxmint/nemo/archive/refs/tags/6.8.5.tar.gz")
depends=(cinnamon-desktop dconf gvfs libexif libgsf libnotify libxml2 python xapp)
makedepends=(meson intltool gobject-introspection)
sha256sums=('8ecbf936f933f5b99546193861a08a9ace6fea5e48bf71de2040cc6d31e9d328')
group=(cinnamon.base)
uses=()
arch=('x86_64')

cd $name-$version

setup () {
    meson setup build --prefix=/usr \
 		--libdir=/usr/lib64/ \
		-Dxmp=false \
		-Dselinux=false
}

build () {
    ninja -C build $jobs
}

package () {
    DESTDIR="$DESTDIR" ninja -C build install $jobs
}
