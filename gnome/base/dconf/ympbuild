#!/usr/bin/env bash
name='dconf'
release='3'
version='51.0'
url='https://gitlab.gnome.org/GNOME/dconf.git/'
description=' Simple low-level configuration system '
email='bayramk@gmail.com'
maintainer='bk'
license=('GPLv3')
source=("https://download.gnome.org/sources/dconf/${version%.*}/dconf-${version}.tar.xz")
depends=(dbus glib)
makedepends=()
sha256sums=('e65c1b7867f836faad9f9ee04acf5c5a6cae2bbc784833fe093207e0cb590248')
group=(gnome.base)
uses=()
arch=('x86_64')

cd $name-$version

setup(){
    meson setup build --prefix=/usr \
        --libdir=/usr/lib64/ \
        -Dman=false
}

build(){
    ninja -C build $jobs
}

package(){
    ninja -C build $jobs install
}

