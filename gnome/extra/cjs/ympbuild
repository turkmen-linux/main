#!/usr/bin/env bash
name='cjs'
release='3'
version='140.3'
url='https://github.com/linuxmint/cjs'
description='Javascript Bindings for Cinnamon'
email='akarsu@protonmail.com'
maintainer='akarsu'
license=('GPL')
source=("https://github.com/linuxmint/cjs/archive/refs/tags/${version}.tar.gz")
depends=(mozjs140)
makedepends=('meson' 'ninja' 'glib' 'gobject-introspection' 'libffi' 'cairo' 'py3-setuptools')
sha256sums=('17401dce140cff85f5662d1fcfcac2a4628d21486a114b4adbeea4f364517348')
group=(gnome.extra)
uses=()
arch=('x86_64')

cd $name-$version

setup(){
    meson setup build --prefix=/usr \
        --libdir=/usr/lib64/
}

build(){
    ninja -C build $jobs
}

package(){
    ninja -C build install $jobs
}

