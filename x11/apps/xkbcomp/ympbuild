#!/usr/bin/env bash
name='xkbcomp'
release='2'
version='1.5.0'
url='https://xorg.freedesktop.org/releases/individual/app/'
description='XKB keyboard description compiler'
email='aliriza.keskin@pardus.org.tr'
maintainer='aliriza'
license=('MIT')
source=('https://xorg.freedesktop.org/releases/individual/app/xkbcomp-1.5.0.tar.gz')
depends=(libxkbfile libX11)
makedepends=()
sha256sums=('d070694dd8d94714aa1da3e3590b75084a4b183da3980866aedd68835954b97c')
group=(x11.apps)
uses=()
arch=('x86_64')

cd $name-$version

setup(){
    autoreconf -fvi
    ./configure --prefix=/usr \
        --libdir=/usr/lib64/
}

build(){
    make $jobs
}

package(){
    make install $jobs
}

