#!/usr/bin/env bash
name='setxkbmap'
release='2'
version='1.3.5'
url='https://xorg.freedesktop.org/releases/individual/app/'
description='Controls the keyboard layout of a running X server'
email='bayramk@gmail.com'
maintainer='bk'
license=('MIT')
source=('https://xorg.freedesktop.org/releases/individual/app/setxkbmap-1.3.5.tar.gz')
depends=(libX11 libXau libXdmcp libXext libXrandr libXrender libxcb libxkbfile)
makedepends=()
sha256sums=('fe5948c40209b2ae35651968566cd09723865bf86a10a27b1e2ce3c6c543dd31')
group=(x11.apps)
uses=()
arch=('x86_64')

cd $name-$version

setup(){
	autoreconf -fvi
    ./configure --prefix=/usr \
        --libdir=/usr/lib64/
}

build(){
    make $jobs
}

package(){
    make install $jobs
}

