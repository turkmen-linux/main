#!/usr/bin/env bash
name='xedit'
release='2'
version='1.2.5'
url='https://xorg.freedesktop.org/releases/individual/app/'
description='Simple text editor for X'
email='akarsu@protonmail.com'
maintainer='akarsu'
license=('MIT')
source=('https://xorg.freedesktop.org/releases/individual/app/xedit-1.2.5.tar.xz'
        'xedit.desktop')
depends=(libXaw libXmu libXt libX11)
makedepends=(util-macros)
sha256sums=('733460cbf20a9d88e2a482ff1b288f51a97150cff807c7ffb98d2430546c8867'
        '111a99e240537d07b1dc46bcca7de0b311085407c8fa8253cae356f453e814e9')
group=(x11.apps)
uses=()
arch=('x86_64')

cd $name-$version

setup(){
    ./configure --prefix=/usr \
        --libdir=/usr/lib64/
}

build(){
    make $jobs
}

package(){
    make DESTDIR="$DESTDIR" install $jobs
    install -Dm644 COPYING "$DESTDIR/usr/share/licenses/$name/COPYING"
    mkdir -p $DESTDIR/usr/share/applications
    install ../xedit.desktop $DESTDIR/usr/share/applications
}
