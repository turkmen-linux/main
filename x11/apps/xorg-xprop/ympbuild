#!/usr/bin/env bash
name='xorg-xprop'
release='1'
version='1.2.8'
url='https://xorg.freedesktop.org/releases/individual/app/'
description='Property displayer for X'
email='akarsu@protonmail.com'
maintainer='akarsu'
license=('MIT')
source=(https://xorg.freedesktop.org/releases/individual/app/xprop-1.2.8.tar.xz{,.sig})
depends=(libX11)
makedepends=(util-macros)
sha256sums=('a8394338c99775160d733d54d73cdcdc5c9c80a0dc8cffd5be1b7c977254b745' 'SKIP')
group=(x11.apps)
uses=()
arch=('x86_64')

cd "xprop"-$version

setup(){
    ./configure --prefix=/usr \
        --libdir=/usr/lib64/
}

build(){
    make $jobs
}

package(){
    make DESTDIR="${DESTDIR}" install $jobs
    install -m755 -d "${DESTDIR}/usr/share/licenses/${name}"
    install -m644 COPYING "${DESTDIR}/usr/share/licenses/${name}/"
}

