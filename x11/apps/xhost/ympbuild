#!/usr/bin/env bash
name='xhost'
release='1'
version='1.0.10'
url='https://xorg.freedesktop.org/releases/individual/app/'
description='X server access control program'
email='aliriza.keskin@pardus.org.tr'
maintainer='aliriza'
license=('MIT')
source=('https://xorg.freedesktop.org/releases/individual/app/xhost-1.0.10.tar.gz')
depends=(libX11)
makedepends=()
sha256sums=('10a157a9c818e6ec17764ba22117e006089107a22aacf58be6de089a76a112f4')
group=(x11.apps)
uses=()
arch=('x86_64')

cd $name-$version

setup(){
    autoreconf -fvi
    ./configure --prefix=/usr \
        --libdir=/usr/lib64/
}

build(){
    make $jobs
}

package(){
    make install $jobs
}

