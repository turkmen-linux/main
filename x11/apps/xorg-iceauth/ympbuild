#!/usr/bin/env bash
name='xorg-iceauth'
release='1'
version='1.0.11'
url='https://xorg.freedesktop.org/releases/individual/app/'
description='ICE authority file utility'
email='akarsu@protonmail.com'
maintainer='akarsu'
license=('MIT')
source=('https://xorg.freedesktop.org/releases/individual/app/iceauth-1.0.11.tar.gz')
depends=(libICE util-macros xorgproto)
makedepends=()
sha256sums=('db417cae6d966e67892ebc3034ec92238af9733c53b5986e56cc8be7db540b3a')
group=(x11.apps)
uses=()
arch=('x86_64')

cd "iceauth"-$version

setup(){
	autoreconf -fvi
    ./configure --prefix=/usr \
        --libdir=/usr/lib64/
}

build(){
    make $jobs
}

package(){
    make install DESTDIR=$DESTDIR $jobs
	install -m755 -d "${DESTDIR}/usr/share/licenses/${name}"
	install -m644 COPYING "${DESTDIR}/usr/share/licenses/${name}/"
}

