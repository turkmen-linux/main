#!/usr/bin/env bash
name='xorg-xset'
release='1'
version='1.2.6'
url='https://xorg.freedesktop.org/releases/individual/app/'
description='User preference utility for X'
email='akarsu@protonmail.com'
maintainer='akarsu'
license=('MIT')
source=('https://xorg.freedesktop.org/releases/individual/app/xset-1.2.6.tar.gz')
depends=(libXmu util-macros)
makedepends=()
sha256sums=('b63c6e3dc531b054284cc14b9cae57cfa1ac99804d7ae1f2fe2f48a1adf260cf' 'SKIP')
group=(x11.apps)
uses=()
arch=('x86_64')

cd "xset"-$version

setup(){
    ./configure --prefix=/usr \
        --libdir=/usr/lib64/ \
        --without-fontcache
}

build(){
    make $jobs
}

package(){
    make DESTDIR="$DESTDIR" install
    install -m755 -d "$DESTDIR/usr/share/licenses/$name"
    install -m644 COPYING "$DESTDIR/usr/share/licenses/$name/"
}

