#!/usr/bin/env bash
name='xrandr'
release='1'
version='1.5.4'
url='https://xorg.freedesktop.org/releases/individual/app/'
description='Primitive command line interface to RandR extension'
email='akarsu@protonmail.com'
maintainer='akarsu'
license=('MIT')
source=('https://xorg.freedesktop.org/releases/individual/app/xrandr-1.5.4.tar.gz')
depends=(libX11 libXrandr)
makedepends=(util-macros)
sha256sums=('b022276f1f2e6e206803027a5f569e6eb51e69d2d8886bfb5a7bc0612ddca4ee')
group=(x11.apps)
uses=()
arch=('x86_64')

cd "xrandr"-$version

setup(){
    ./configure --prefix=/usr \
        --libdir=/usr/lib64/
}

build(){
    make $jobs
}

package(){
    make install $jobs
}

