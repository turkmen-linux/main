#!/usr/bin/env bash
name='mkfontscale'
release='2'
version='1.2.4'
url='https://xorg.freedesktop.org/releases/individual/app/'
description='create an index of scalable font files for X'
email='bayramk@gmail.com'
maintainer='bk'
license=('MIT')
source=('https://xorg.freedesktop.org/releases/individual/app/mkfontscale-1.2.4.tar.gz')
depends=(freetype libfontenc)
makedepends=()
sha256sums=('076cedba00195e81d055fb39eff94c057f97326ac2403cf71460fc613cd200bf')
group=(x11.apps)
uses=()
arch=('x86_64')

cd $name-$version

setup(){
	autoreconf -fvi
    ./configure --prefix=/usr \
        --libdir=/usr/lib64/
}

build(){
    make $jobs
}

package(){
    make install $jobs
}

