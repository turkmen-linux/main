#!/usr/bin/env bash
name='xeyes'
release='1'
version='1.3.1'
url='https://xorg.freedesktop.org/releases/individual/app/'
description='X.Org xeyes application'
email='bk@gmail.com'
maintainer='bk'
license=('MIT')
source=('https://xorg.freedesktop.org/releases/individual/app/xeyes-1.3.1.tar.gz')
depends=(libICE libSM libXau libXau libXext libXi libXmu libXrender libXt libxcb)
makedepends=()
sha256sums=('d223283270488b1a6b408d0e97bd69a7704cf6a9596c0320035d807e63cdc084')
group=(x11.apps)
uses=()
arch=('x86_64')

cd $name-$version

setup(){
	autoreconf -fvi
    ./configure --prefix=/usr \
        --libdir=/usr/lib64/
}

build(){
    make $jobs
}

package(){
    make install $jobs
}

