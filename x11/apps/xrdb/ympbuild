#!/usr/bin/env bash
name='xrdb'
release='1'
version='1.2.3'
url='https://xorg.freedesktop.org/releases/individual/app/'
description='X resource database utility'
email='aliriza.keskin@pardus.org.tr'
maintainer='aliriza'
license=('MIT')
source=('https://xorg.freedesktop.org/releases/individual/app/xrdb-1.2.3.tar.gz')
depends=(libX11)
makedepends=()
sha256sums=('89c3d0a5ee77e3f1b25a3a63cce2a322fe899acb061ed8e0bab6920189b61edd')
group=(x11.apps)
uses=()
arch=('x86_64')

cd $name-$version

setup(){
    autoreconf -fvi
    ./configure --prefix=/usr \
        --libdir=/usr/lib64/
}

build(){
    make $jobs
}

package(){
    make install $jobs
}

