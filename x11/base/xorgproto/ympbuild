#!/usr/bin/env bash
name='xorgproto'
release='6'
version='2026.1'
url='https://gitlab.freedesktop.org/xorg/proto/xorgproto'
description='X.Org combined protocol headers'
email='kurth4cker@tutanota.com'
maintainer='kurth4cker'
license=('MIT')
source=("https://www.x.org/releases/individual/proto/xorgproto-${version}.tar.xz")
depends=()
makedepends=(util-macros)
sha256sums=('f9bfe4a9ed8c8ab9d2a3b0d49797f046052dadd06b7a8b45dbffaffb137e8290')
uses=()
arch=('x86_64')
group=(x11.base)

cd $name-$version

setup(){
    autoreconf -fvi
    ./configure --prefix=/usr \
        --libdir=/usr/lib64 \
        --without-xmlto \
        --without-xsltproc
}

build(){
    make $jobs
}

package(){
    make install $jobs
}
