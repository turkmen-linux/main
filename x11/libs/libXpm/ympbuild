#!/usr/bin/env bash
name='libXpm'
release='4'
version='3.5.20'
url='https://gitlab.freedesktop.org/xorg/lib/libXpm'
description='X.Org Xpm library'
email='bayramk@gmail.com'
maintainer='bk'
license=('MIT')
source=("https://www.x.org/archive/individual/lib/libXpm-$version.tar.xz")
depends=(libX11)
makedepends=()
sha256sums=('c064ead03e4dde78afdeb121fe0b644d25c550444cf903fbdc537f1a78f3ef74')
group=(x11.libs)
uses=()
arch=('x86_64')

cd $name-$version

setup(){
    autoreconf -vfi
    ./configure --prefix=/usr \
        --libdir=/usr/lib64/
}

build(){
    make $jobs
}

package(){
    make install $jobs
}

