#!/usr/bin/env bash
name='libXmu'
release='2'
version='1.1.4'
url='https://gitlab.freedesktop.org/xorg/lib/libXmu'
description='X.Org Xmu library'
email='bayramk@gmail.com'
maintainer='bk'
license=('MIT')
source=("https://www.x.org/archive/individual/lib/libXmu-$version.tar.xz")
depends=(libXt libXext libX11)
makedepends=()
sha256sums=('210de3ab9c3e9382572c25d17c2518a854ce6e2c62c5f8315deac7579e758244')
group=(x11.libs)
uses=()
arch=('x86_64')

cd $name-$version

setup(){
    ./configure --prefix=/usr \
        --libdir=/usr/lib64/
}

build(){
    make $jobs
}

package(){
    make install $jobs
}

