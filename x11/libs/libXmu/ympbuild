#!/usr/bin/env bash
name='libXmu'
release='3'
version='1.3.1'
url='https://gitlab.freedesktop.org/xorg/lib/libXmu'
description='X.Org Xmu library'
email='bayramk@gmail.com'
maintainer='bk'
license=('MIT')
source=("https://www.x.org/archive/individual/lib/libXmu-$version.tar.xz")
depends=(libXt libXext libX11)
makedepends=()
sha256sums=('81a99e94c4501e81c427cbaa4a11748b584933e94b7a156830c3621256857bc4')
group=(x11.libs)
uses=()
arch=('x86_64')

cd $name-$version

setup(){
    ./configure --prefix=/usr \
        --libdir=/usr/lib64/
}

build(){
    make $jobs
}

package(){
    make install $jobs
}

