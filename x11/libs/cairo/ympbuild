#!/usr/bin/env bash
name='cairo'
release='3'
version='1.18.6'
url='https://gitlab.freedesktop.org/cairo/cairo.git/'
description='A vector graphics library with cross-device output support'
email='bayramk@gmail.com'
maintainer='bk'
license=('GPLv3')
source=("https://gitlab.freedesktop.org/cairo/cairo/-/archive/$version/cairo-$version.tar.gz")
depends=(pixman libpng glib libpcre2 fontconfig libX11 libXext libXrender)
makedepends=(gtk-doc meson)
sha256sums=('a95ae4f522ef24312af7339563f65e0a03b1ad3d58a46df73d2ef690fe15ae7f')
group=(x11.libs)
uses=()
arch=('x86_64')

cd $name-$version

setup(){
	meson setup build --prefix=/usr \
        --libdir=/usr/lib64/ \
        -D b_lto=true \
        -D gtk_doc=false \
        -D spectre=disabled \
        -D symbol-lookup=disabled \
        -D tests=disabled
}

build(){
    ninja -C build
}

package(){
    ninja -C build install
}

