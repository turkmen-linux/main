#!/usr/bin/env bash
name='libdrm'
release='4'
version='2.4.133'
url='https://gitlab.freedesktop.org/mesa/drm'
description='X.Org libdrm library'
email='bk@gmail.com'
maintainer='bk'
license=('GPLv3')
source=("https://dri.freedesktop.org/libdrm/libdrm-$version.tar.xz")
depends=(libpciaccess)
makedepends=()
sha256sums=('fc68f9d0ba2ea63c9432a299e14fea09fad7a8a66e8039fcd7802ca59f77b4f5')
group=(x11.libs)
uses=()
arch=('x86_64')

cd $name-$version

export LANG=en_US.UTF-8

setup(){
    meson setup build --prefix=/usr \
        -D default_library=both \
        -D udev=false \
        -D etnaviv=disabled \
        -D freedreno=disabled \
        -D vc4=disabled \
        -D valgrind=disabled \
        -D install-test-programs=false \
        -D man-pages=disabled
}

build(){
    ninja -C build
}

package(){
    ninja -C build install
}

