#!/usr/bin/env bash
name='libdrm'
release='5'
version='2.4.134'
url='https://gitlab.freedesktop.org/mesa/drm'
description='X.Org libdrm library'
email='bk@gmail.com'
maintainer='bk'
license=('GPLv3')
source=("https://dri.freedesktop.org/libdrm/libdrm-$version.tar.xz")
depends=(libpciaccess)
makedepends=()
sha256sums=('ac5e74d157830eb8bee44c6a6bf3ad49774ef0dd2a72bdad74a8f20308b52a95')
group=(x11.libs)
uses=()
arch=('x86_64')

cd $name-$version

export LANG=en_US.UTF-8

setup(){
    meson setup build --prefix=/usr \
        -D default_library=both \
        -D udev=false \
        -D etnaviv=disabled \
        -D freedreno=disabled \
        -D vc4=disabled \
        -D valgrind=disabled \
        -D install-test-programs=false \
        -D man-pages=disabled
}

build(){
    ninja -C build
}

package(){
    ninja -C build install
}

