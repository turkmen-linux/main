#!/usr/bin/env bash
name='libXvMC'
release='2'
version='1.0.15'
url='https://gitlab.freedesktop.org/xorg/lib/libXvMC'
description='X.Org XvMC library'
email='bayramk@gmail.com'
maintainer='bk'
license=('MIT')
source=("https://www.x.org/archive/individual/lib/libXvMC-$version.tar.xz")
depends=(libX11 libXext libXv xorgproto )
makedepends=()
sha256sums=('4f518afde3d7fd435346af7b368d2f73517f3d5f82647c962caf3f7bb8ff7078')
group=(x11.libs)
uses=()
arch=('x86_64')

cd $name-$version

setup(){
    # Skip pkg-config checks for missing dependencies
    export Xv_CFLAGS="-I/usr/include"
    export Xv_LIBS="-lXv"
    ./configure --prefix=/usr \
        --libdir=/usr/lib64/ \
        --without-xv
}

build(){
    make $jobs
}

package(){
    make install $jobs
}

