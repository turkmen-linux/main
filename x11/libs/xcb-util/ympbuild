#!/usr/bin/env bash
name='xcb-util'
release='2'
version='0.4.1'
url='https://xcb.freedesktop.org'
description='X C-language Bindings sample implementations'
email='kurth4cker@tutanota.com'
maintainer='kurth4cker'
license=('MIT')
source=("https://www.x.org/releases/individual/xcb/xcb-util-${version}.tar.gz")
depends=(libxcb)
makedepends=(util-macros xorgproto)
sha256sums=('21c6e720162858f15fe686cef833cf96a3e2a79875f84007d76f6d00417f593a')
uses=()
arch=('x86_64')
group=(x11.libs)

cd $name-$version

setup(){
    aclocal
    autoreconf -vfi
    ./configure --prefix=/usr \
        --libdir=/usr/lib64 \
	--enable-shared \
	--enable-static \
	--disable-devel-docs \
	--without-doxygen
}

build(){
    make $jobs
}

package(){
    make install $jobs
}
