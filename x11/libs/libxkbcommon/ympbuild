#!/usr/bin/env bash
name='libxkbcommon'
release='5'
version='1.13.2'
url='https://github.com/xkbcommon/libxkbcommon'
description='keymap handling library for toolkits and window systems'
email='aliriza.keskin@pardus.org.tr'
maintainer='aliriza'
license=('GPLv3')
source=("https://github.com/xkbcommon/libxkbcommon/archive/refs/tags/xkbcommon-$version.tar.gz")
depends=(libxml2 libxcb xkeyboard-config)
makedepends=()
sha256sums=('acc4d5f7c3cbba5f9f8d08d8bdbeede84ecede46792f47929aa9321873385528')
group=(x11.libs)
uses=(wayland)
wayland_depends=(wayland-protocols wayland)
arch=('x86_64')

cd libxkbcommon-xkbcommon-$version

setup(){
    meson setup build \
        --prefix=/usr \
        --libdir=/usr/lib64/ \
        -Denable-docs=false \
        -Denable-wayland=$(use_opt wayland true false)
}

build(){
    ninja -C build
}

package(){
    ninja -C build install
}

