#!/usr/bin/env bash
name='libXfont2'
release='4'
version='2.0.10'
url='https://gitlab.freedesktop.org/xorg/lib/libXfont2'
description='X.Org Xfont library'
email='bayramk@gmail.com'
maintainer='bk'
license=('MIT')
source=("https://www.x.org/archive/individual/lib/libXfont2-$version.tar.xz")
depends=()
makedepends=()
sha256sums=('cef1f4ad9cd69f439bb1ac484bdc8f9d7f8e70215b92d8ca86b96e31513e5f9c')
group=(x11.libs)
uses=()
arch=('x86_64')

cd $name-$version

setup(){
    autoreconf -fvi
    ./configure --prefix=/usr \
        --libdir=/usr/lib64/
}

build(){
    make $jobs
}

package(){
    make install $jobs
}

