#!/usr/bin/env bash
name='xcb-util-cursor'
release='2'
version='0.1.6'
url='https://xcb.freedesktop.org'
description='X C-language Bindings sample implementations'
email='kurth4cker@tutanota.com'
maintainer='kurth4cker'
license=('MIT')
source=("https://www.x.org/releases/individual/xcb/xcb-util-cursor-${version}.tar.xz")
depends=(libxcb xcb-util-image xcb-util-renderutil)
makedepends=(xorgproto)
sha256sums=('fdeb8bd127873519be5cc70dcd0d3b5d33b667877200f9925a59fdcad8f7a933')
group=(x11.libs)
uses=()
arch=('x86_64')

cd $name-$version

setup(){
    ./configure --prefix=/usr \
        --libdir=/usr/lib64 \
	--enable-shared \
	--enable-static \
	--disable-devel-docs \
	--without-doxygen
}

build(){
    make $jobs
}

package(){
    make install $jobs
}
