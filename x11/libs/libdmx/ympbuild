#!/usr/bin/env bash
name='libdmx'
release='2'
version='1.1.5'
url='https://gitlab.freedesktop.org/xorg/lib/libdmx'
description='X.Org dmx library'
email='bayramkk@gmail.com'
maintainer='bk'
license=('GPLv3')
source=("https://www.x.org/archive/individual/lib/libdmx-$version.tar.gz")
depends=()
makedepends=()
sha256sums=('070e82cc1daa1b21ee1339aef56a909eab04cbe7d430fabfbb01ecd21b2dd9f3')
group=(x11.libs)
uses=()
arch=('x86_64')

cd $name-$version

setup(){
    aclocal -I m4
    autoreconf -vfi
    ./configure --prefix=/usr \
        --libdir=/usr/lib64/
}

build(){
    make $jobs
}

package(){
    make install $jobs
}

