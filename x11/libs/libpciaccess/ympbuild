#!/usr/bin/env bash
name='libpciaccess'
release='3'
version='0.19'
url='https://gitlab.freedesktop.org/xorg/lib/libpciaccess'
description='Library providing generic access to the PCI bus and devices'
email='bayramk@gmail.com'
maintainer='bk'
license=('GPLv3')
source=("https://www.x.org/archive/individual/lib/libpciaccess-$version.tar.xz")
depends=()
makedepends=()
sha256sums=('3c55aa86c82e54a4e3109786f0463530d53b36b6d1cfd14616454f985dd2aa43')
group=(x11.libs)
uses=()
arch=('x86_64')

cd $name-$version

setup(){
    meson setup build --prefix=/usr \
        --libdir=/usr/lib64/ \
        -Ddefault_library=both
}

build(){
    ninja -C build $jobs
}

package(){
    ninja -C build install $jobs
}

