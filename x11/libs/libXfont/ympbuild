#!/usr/bin/env bash
name='libXfont'
release='1'
version='1.5.4'
url='https://gitlab.freedesktop.org/xorg/lib/libXfont'
description='X.Org Xfont library'
email='bayramk@gmail.com'
maintainer='bk'
license=('MIT')
source=("https://www.x.org/archive/individual/lib/libXfont-$version.tar.gz")
depends=(libfontenc freetype)
makedepends=()
sha256sums=('59be6eab53f7b0feb6b7933c11d67d076ae2c0fd8921229c703fc7a4e9a80d6e')
group=(x11.libs)
uses=()
arch=('x86_64')

cd $name-$version

setup(){
    ./configure --prefix=/usr \
        --libdir=/usr/lib64/
}

build(){
    make $jobs
}

package(){
    make install $jobs
}

