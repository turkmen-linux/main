#!/usr/bin/env bash
name='libXxf86vm'
release='2'
version='1.1.7'
url='https://gitlab.freedesktop.org/xorg/lib/libXxf86vm'
description='X.Org Xxf86vm library'
email='bayramk@gmail.com'
maintainer='bk'
license=('MIT')
source=("https://www.x.org/archive/individual/lib/libXxf86vm-$version.tar.xz")
depends=()
makedepends=()
sha256sums=('ae50c0f669e0af5a67cc4cd0f54f21d64a64d2660af883e80e95d3fe51b945d8')
group=(x11.libs)
uses=()
arch=('x86_64')

cd $name-$version

setup(){
