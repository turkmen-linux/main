#!/usr/bin/env bash
name='gdk-pixbuf'
release='3'
version='2.44.8'
url='https://gitlab.gnome.org/GNOME/gdk-pixbuf'
description='gdk-pixbuf Image loading library for GTK+ '
email='bayramk@gmail.com'
maintainer='bk'
license=('GPLv3')
source=("https://download.gnome.org/sources/gdk-pixbuf/${version%.*}/gdk-pixbuf-$version.tar.xz"
        "gdk-pixbuf.sysconf")
depends=(libjpeg-turbo shared-mime-info gi-docgen libtiff libpng)
makedepends=()
sha256sums=('919f529512961a12e81cd4b4b466a48c3933469e7f9a310c6513cd4fb252ba3c'
         'SKIP')
group=(x11.libs)
uses=()
arch=('x86_64')

cd $name-$version

setup(){
    meson setup build --prefix=/usr \
        --libdir=/usr/lib64/ \
        -Dman=false \
        -D installed_tests=false \
        -D tiff=enabled \
        -D glycin=disabled \
        -D tests=false

}

build(){
    ninja -C build
}

package(){
    ninja -C build install
    mkdir -p ${DESTDIR}/etc/sysconf.d/
    install -Dm644 ../gdk-pixbuf.sysconf ${DESTDIR}/etc/sysconf.d/gdk-pixbuf
}

