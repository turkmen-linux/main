AC_DEFUN([AM_MISSING_PROG],
[AC_REQUIRE([AC_PROG_INSTALL])dnl
if test -z "$$1"; then
  AC_MSG_WARN($0: must be called with AM_MISSING_PROG($program, install-sh))
fi
AC_PATH_PROG($1, $2, install, ${srcdir}/missing ${abs_builddir}/missing)
m4_if($1, [install], [], [AC_SUBST($1)])
])

AC_DEFUN([AC_PROG_LIBTOOL],
[AC_REQUIRE([AC_PROG_INSTALL])
AC_REQUIRE([AM_MISSING_PROG])
AC_CHECK_TOOL(LIBTOOL, libtool, :)
test -z "$LIBTOOL" && LIBTOOL="$$libtool"
AC_SUBST(LIBTOOL)
])

