#!/usr/bin/env bash
name='libthai'
release='2'
version='0.1.30'
url='https://github.com/tlwg/libthai'
description='Package libthai'
email='bayramk@gmail.com'
maintainer='bk'
license=('GPLv3')
source=("https://github.com/tlwg/libthai/releases/download/v$version/libthai-$version.tar.xz")
depends=(libdatrie)
makedepends=()
sha256sums=('ddba8b53dfe584c3253766030218a88825488a51a7deef041d096e715af64bdd')
group=(x11.libs)
uses=()
arch=('x86_64')

cd $name-$version

setup(){
