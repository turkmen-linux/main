#!/usr/bin/env bash
name='libSM'
release='2'
version='1.2.6'
url='https://gitlab.freedesktop.org/xorg/lib/libSM'
description='libSM X.Org Session Management library'
email='bayramk@gmail.com'
maintainer='bk'
license=('GPLv3')
source=("https://www.x.org/archive/individual/lib/libSM-$version.tar.xz")
depends=(xorgproto libICE)
makedepends=()
sha256sums=('be7c0abdb15cbfd29ac62573c1c82e877f9d4047ad15321e7ea97d1e43d835be')
group=(x11.libs)
uses=()
arch=('x86_64')

cd $name-$version

setup(){
    aclocal
    autoreconf -vfi
    ./configure --prefix=/usr \
        --libdir=/usr/lib64/
}

build(){
    make $jobs
}

package(){
    make install $jobs
}

