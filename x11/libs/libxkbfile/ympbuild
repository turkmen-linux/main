#!/usr/bin/env bash
name='libxkbfile'
release='2'
version='1.2.0'
url='https://gitlab.freedesktop.org/xorg/lib/libxkbfile.git/'
description='X.Org xkbfile library'
email='bayramk@gmail.com'
maintainer='bk'
license=('GPLv3')
source=("https://www.x.org/archive/individual/lib/libxkbfile-$version.tar.xz")
depends=(libX11 xorgproto)
makedepends=()
sha256sums=('7f71884e5faf56fb0e823f3848599cf9b5a9afce51c90982baeb64f635233ebf')
group=(x11.libs)
uses=()
arch=('x86_64')

cd $name-$version

setup(){
    meson setup build --prefix=/usr \
        --libdir=/usr/lib64/
}

build(){
    ninja -C build
}

package(){
    DESTDIR="$DESTDIR" ninja -C build install
}

