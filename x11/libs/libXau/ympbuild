#!/usr/bin/env bash
name='libXau'
release='3'
version='1.0.12'
url='https://xorg.freedesktop.org/releases/individual/lib/'
description='X.Org X authorization library'
email='kurth4cker@tutanota.com'
maintainer='kurth4cker'
license=('MIT')
source=("https://xorg.freedesktop.org/releases/individual/lib/libXau-${version}.tar.gz")
depends=(xorgproto)
makedepends=()
sha256sums=('2402dd938da4d0a332349ab3d3586606175e19cb32cb9fe013c19f1dc922dcee')
uses=()
arch=('x86_64')
group=(x11.libs)

cd $name-$version

setup(){
    autoreconf -fvi
    ./configure --prefix=/usr \
        --libdir=/usr/lib64 \
        --enable-static \
        --enable-shared
}

build(){
    make $jobs
}

package(){
    make install $jobs
}

