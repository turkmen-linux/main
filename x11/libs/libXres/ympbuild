#!/usr/bin/env bash
name='libXres'
release='2'
version='1.2.3'
url='https://gitlab.freedesktop.org/xorg/lib/libXres'
description='X.Org XRes library'
email='bayramk@gmail.com'
maintainer='bk'
license=('MIT')
source=("https://www.x.org/archive/individual/lib/libXres-$version.tar.xz")
depends=(libX11 libXext xorgproto)
makedepends=()
sha256sums=('d2de8f5401d6c86a8992791654547eb8def585dfdc0c08cc16e24ef6aeeb69dc')
group=(x11.libs)
uses=()
arch=('x86_64')

cd $name-$version

setup(){
    ./configure --prefix=/usr \
        --libdir=/usr/lib64/
}

build(){
    make $jobs
}

package(){
    make install $jobs
}

