#!/usr/bin/env bash
name='pango'
release='4'
version='1.58.2'
url='https://download.gnome.org/sources/pango/1.58/pango-1.58.2.tar.xz'
description='Layout and render international text'
email='bk@gmail.com'
maintainer='bk'
license=('GPLv3')
source=("https://download.gnome.org/sources/pango/1.58/pango-${version}.tar.xz")
depends=(fribidi libthai harfbuzz cairo libXft)
makedepends=(gobject-introspection)
sha256sums=('342385b6ca3b7c73455d7c80a13b7dbe4489e00bc3bd4c5bd6ed4dce421e374a')
group=(x11.libs)
uses=()
arch=('x86_64')

cd $name-$version

export LDFLAGS="-lfreetype"
setup(){
    meson setup build --prefix=/usr \
        --libdir=/usr/lib64/ \
        -Dintrospection=enabled \
        -Dcairo=enabled \
        -Dlibthai=enabled
}

build(){
    ninja -C build
}

package(){
    ninja -C build install
}

