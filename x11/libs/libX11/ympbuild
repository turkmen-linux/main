#!/usr/bin/env bash
name='libX11'
release='3'
version='1.8.14'
url='https://xorg.freedesktop.org/releases/individual/lib/'
description='X.Org X11 library'
email='bk@gmail.com'
maintainer='bk'
license=('MIT')
source=("https://xorg.freedesktop.org/releases/individual/lib/libX11-$version.tar.gz")
depends=(libxcb libXau libXdmcp xtrans)
makedepends=()
sha256sums=('ebb8a58549ddde50aa2e742b3b256557f451053d173be8dbfc2e8ac078eee1d6')
group=(x11.libs)
uses=()
arch=('x86_64')

cd $name-$version

setup(){
    autoreconf -fvi
    ./configure --prefix=/usr \
        --libdir=/usr/lib64/
}

build(){
    make $jobs
}

package(){
    make install $jobs
}
