#!/usr/bin/env bash
name='libXt'
release='3'
version='1.3.1'
url='https://gitlab.freedesktop.org/xorg/lib/libXt'
description='X.Org X Toolkit Intrinsics library'
email='bayramk@gmail.com'
maintainer='bk'
license=('MIT')
source=("https://www.x.org/archive/individual/lib/libXt-$version.tar.gz")
depends=(libSM libX11)
makedepends=()
sha256sums=('cf2212189869adb94ffd58c7d9a545a369b83d2274930bfbe148da354030b355')
group=(x11.libs)
uses=()
arch=('x86_64')

cd $name-$version

setup(){
    ./configure --prefix=/usr \
        --libdir=/usr/lib64/
}

build(){
    make $jobs
}

package(){
    make install $jobs
}

