#!/usr/bin/env bash
name='libxshmfence'
release='2'
version='1.3.3'
url='https://gitlab.freedesktop.org/xorg/lib/libxshmfence.git/'
description='Shared memory fences using futexes'
email='bayramk@gmail.com'
maintainer='bk'
license=('GPLv3')
source=("https://www.x.org/archive/individual/lib/libxshmfence-$version.tar.xz")
depends=(xorgproto)
makedepends=()
sha256sums=('d4a4df096aba96fea02c029ee3a44e11a47eb7f7213c1a729be83e85ec3fde10')
group=(x11.libs)
uses=()
arch=('x86_64')

cd $name-$version

setup(){
    aclocal
    autoreconf -vfi
    ./configure --prefix=/usr \
        --libdir=/usr/lib64/
}

build(){
    make $jobs
}

package(){
    make install $jobs
}

