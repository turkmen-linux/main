#!/usr/bin/env bash
name='lxpanel'
release='3'
version='0.11.1'
url='https://wiki.lxde.org/en/LXPanel'
description='Lightweight X11 desktop panel for LXDE '
email='bayramk@gmail.com'
maintainer='bk'
license=('GPLv3')
source=("https://github.com/lxde/lxpanel/archive/refs/tags/0.11.1.tar.gz"
        "lxpanel-0.10.1-c99.patch")
depends=(libwnck3 wireless-tools libkeybinder3 alsa-lib curl libX11 libfm libxml2)
makedepends=()
sha256sums=('24334dde6ed37d32bb021f902dbd54a1e6cdd01f35a778d80fcd3acd23a0e93b'
            'SKIP')
group=(lxde.base)
uses=()
arch=('x86_64')

cd $name-$version

export CC=clang
export CFLAGS="-Wno-all -O2 -s"
export CXXFLAGS="-Wno-all -O2 -s"


CFLAGS="$CFLAGS -I/usr/include/libwnck-3.0"

prepare(){

    # Disable pager plugin as it breaks panel layout with GTK+ 3
    # https://sourceforge.net/p/lxde/bugs/773/
    sed -i '/pager.c/d' plugins/Makefile.am
    sed -i '/STATIC_PAGER/d' src/private.h
    sed -i 's/libwnck-3.0//' configure.ac
    sed -i 's/background=1/background=0/' data/default/panels/panel.in
}

setup(){
    # Fix AM_NLS macro issue - add m4_pattern_allow in configure.ac
    sed -i 's/IT_PROG_INTLTOOL/IT_PROG_INTLTOOL\nm4_pattern_allow([^AM_NLS$])/g' configure.ac
    
    autoreconf -fvi
    ./configure --prefix=/usr \
        --libdir=/usr/lib64/ \
        --enable-gtk3 \
        --disable-silent-rules \
        --with-plugins=all,-cpufreq
}

build(){
    make $jobs
}

package(){
    make install $jobs
}

