#!/usr/bin/env bash
name='lxsession'
release='3'
version='0.5.7'
url='https://lxde.org'
description='Lightweight X11 session manager'
email='akarsu@protonmail.com'
maintainer='akarsu'
license=('GPL2')
source=("https://github.com/lxde/lxsession/archive/refs/tags/0.5.7.tar.gz")
depends=(gtk3 polkit glib libX11 libX11)
makedepends=(intltool vala docbook-xsl)
sha256sums=('150dd1b78bb663775cd499a452817f8de9ae79b154c5c765d457d6f54daa608b')
group=(lxde.base)
uses=()
arch=('x86_64')

cd $name-$version

export CC="clang"
export CXX="clang++"

setup(){
    ./autogen.sh
    ./configure --prefix=/usr\
        --sysconfdir=/etc \
        --libexecdir=/usr/libexec \
        --enable-gtk3 \
        --libdir=/usr/lib64/
}

build(){
    make $jobs
}

package(){
    make  DESTDIR="$DESTDIR" install $jobs
    # Ignore package by AppStream to avoid duplicated IDs
    echo 'X-AppStream-Ignore=true' >> "$DESTDIR/usr/share/applications/lxsession-default-apps.desktop"
    echo 'X-AppStream-Ignore=true' >> "$DESTDIR/usr/share/applications/lxsession-edit.desktop"
}

